# ---- Input: use ONE of these ----
# Google Sheet must be shared "Anyone with the link can view". Paste the normal sheet URL.
SHEET_CSV_URL=
# or a local CSV (columns: Name, University, Email, Profile Link, Research Interests, Applied)
CSV_PATH=./professors.csv

# ---- CV attachment ----
CV_PATH=C:\Users\Hamza\Documents\Muhammad_Hamza_CV.pdf

# ---- Sending (Gmail recommended: Google Account > Security > 2-Step Verification > App passwords) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
FROM_NAME=Muhammad Hamza
SUBJECT=CSC 2027 PhD Application Enquiry - Muhammad Hamza

# ---- Hook generation (OpenRouter) ----
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openrouter/free
USE_WEB_SEARCH=true

# ---- Pacing ----
DAILY_LIMIT=20
MIN_DELAY_MIN=4
MAX_DELAY_MIN=11
# Skip professors whose CV-fit rating is below this (0 = send all)
MIN_RATING=0
# Hooks with confidence "low" are held for manual approval unless this is true
SEND_LOW_CONFIDENCE=false

#For websearch langsearch api key
LANGSEARCH_API_KEY=*************

# SAFETY: stays true until you set it to false. true = write emails to ./outbox, send nothing.
DRY_RUN=true
