# ---- Input: use ONE of these ----
# Optional local dashboard port (restart the dashboard after changing)
PORT=4173
# Google Sheet must be shared "Anyone with the link can view". Paste the normal sheet URL.
SHEET_CSV_URL=
# or a local CSV (columns: Name, University, Email, Profile Link, Research Interests, Applied)
CSV_PATH=./professors.csv

# ---- CV attachment ----
CV_PATH=./Muhammad_Hamza_CV.pdf
PROMPTS_DIR=./prompts

# ---- Sending (Gmail recommended: Google Account > Security > 2-Step Verification > App passwords) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
FROM_NAME=Muhammad Hamza
SUBJECT=CSC 2027 PhD Application Enquiry - Muhammad Hamza

# ---- Reply and bounce checks (optional; blank credentials reuse SMTP) ----
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
FOLLOW_UP_DAYS=7

# ---- Local daily campaign schedule (dashboard must remain running) ----
SCHEDULE_ENABLED=false
SCHEDULE_TIME=09:00
SCHEDULE_DAILY_LIMIT=20

# ---- Hook generation (OpenRouter) ----
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
USE_WEB_SEARCH=true
# OpenAlex works input requires an API key in this app; get one at https://openalex.org/settings/api
OPENALEX_ENABLED=false
OPENALEX_API_KEY=

# ---- Pacing ----
DAILY_LIMIT=20
MIN_DELAY_MIN=4
MAX_DELAY_MIN=11
# Skip professors whose CV-fit rating is below this (0 = send all)
MIN_RATING=0
# Hooks with confidence "low" are held for manual approval unless this is true
SEND_LOW_CONFIDENCE=false

#For websearch langsearch api key
LANGSEARCH_API_KEY=*************

# SAFETY: stays true until you set it to false. true = write emails to ./outbox, send nothing.
DRY_RUN=true
